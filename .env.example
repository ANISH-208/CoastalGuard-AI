DATABASE_URL=sqlite:///./coastguard.db
LOAD_DEMO_FIXTURES=false
APP_ENV=development
LOG_LEVEL=INFO

# Conservative display guardrails (hours)
ADVISORY_MAX_AGE_HOURS=24
SOURCE_STALE_AFTER_HOURS=24

# Live source access is intentionally disabled. Set true only after confirming permission.
IMD_MARINE_ENABLED=false
# Configure only an endpoint documented for your approved IMD account.
IMD_MARINE_ENDPOINT=
# Optional: set both only if IMD's documentation/support specifies this header.
IMD_AUTH_HEADER_NAME=
IMD_AUTH_HEADER_VALUE=
IMD_TIMEOUT_SECONDS=10

# Required to enable protected administrative endpoints. Use a long random secret.
# Never commit the real value; configure it in your local .env or deployment secret store.
ADMIN_API_TOKEN=

# Comma-separated exact frontend origins. Do not use wildcards for production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker Compose only. Use URL-safe random values and keep .env out of Git.
POSTGRES_PASSWORD=

# Local JSON import limits
MAX_IMPORT_FILE_BYTES=5000000
MAX_IMPORT_RECORDS=5000
